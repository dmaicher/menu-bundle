{
    "name": "dama/menu-bundle",
    "description": "",
    "keywords": [],
    "homepage": "https://github.com/dmaicher/menu-bundle",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "David Maicher",
            "email": "mail@dmaicher.de"
        }
    ],
    "require": {
        "php": ">=8.1",
        "symfony/framework-bundle": "^6.4 || ^7.3",
        "symfony/twig-bundle": "^6.4 || ^7.3",
        "twig/twig": "^2.4.4 || ^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^v3.88.2",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan": "^2.1.30",
        "phpstan/phpstan-symfony": "^2.0.8",
        "phpunit/phpunit": "^10.5.58",
        "symfony/browser-kit": "^6.4 || ^7.3",
        "symfony/css-selector": "^6.4 || ^7.3",
        "symfony/expression-language": "^6.4 || ^7.3",
        "symfony/security-bundle": "^6.4 || ^7.3",
        "symfony/yaml": "^6.4 || ^7.3"
    },
    "autoload": {
        "psr-4": {
            "DAMA\\MenuBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": { "Tests\\": "tests/" }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "5.x-dev"
        }
    }
}
